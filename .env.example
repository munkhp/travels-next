# --- Sanity (content: all text & images) ---------------------------------
# Create a project at https://sanity.io/manage, then copy its project id.
# Without these the app serves the bundled JSON snapshot in src/data/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run `npm run sanity:migrate` (one-time import).
# Create at sanity.io/manage → your project → API → Tokens → "Editor".
SANITY_API_TOKEN=

# --- MongoDB (optional: booking & contact form submissions) ---------------
# MONGODB_URI=mongodb://localhost:27017/travels

# --- Email via Mailgun SMTP (optional: enquiry & message notifications) ---
# Mailgun dashboard → Sending → Domain settings → SMTP credentials.
# Username is postmaster@<your-mailgun-domain>. EMAIL_FROM must be an address
# on that same domain. Sandbox domains only deliver to authorized recipients.
# SMTP_USER=postmaster@mail.tourinmongolia.com
# SMTP_PASS=
# EMAIL_FROM="Travels in Mongolia <no-reply@mail.tourinmongolia.com>"
# Defaults: smtp.mailgun.org, port 587 (use smtp.eu.mailgun.org for EU).
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587

# --- Cloudflare Turnstile (optional: bot protection on both forms) --------
# dash.cloudflare.com → Turnstile → add a site, then copy both keys.
# Leave the secret unset locally and submissions skip the check.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
